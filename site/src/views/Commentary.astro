---
import Base from "../layouts/Base.astro";
import PeriodReturns from "../components/PeriodReturns.astro";
import { T, href, fmtPeriod, fmtDate } from "../lib/i18n.js";
import { listCommentary, kindLabel } from "../lib/content.js";
import { loadResults, loadPortfolios, PORTFOLIO_IDS } from "../lib/data.js";
interface Props { lang: "en" | "es"; slug: string }
const { lang, slug } = Astro.props;
const t = T[lang];
const en = lang === "en";
const all = listCommentary(lang);
const i = all.findIndex((x) => x.slug === slug);
const c = all[i];
const older = all[i + 1], newer = all[i - 1];
const { Content } = c;
const names = Object.fromEntries(loadPortfolios().map((p) => [p.id, p.name]));
const heading = c.title || fmtPeriod(lang, c.period);
const lede = `${kindLabel(lang, c.kind)}, ${fmtPeriod(lang, c.period)}` +
  (c.written ? `. ${t.written} ${fmtDate(lang, c.written, { day: "numeric", month: "long", year: "numeric" })}` : "");
const toc = c.filled ? c.headings : [];
---
<Base lang={lang} title={heading} path={`commentary/${slug}/`} heading={heading} lede={lede}
      description={c.excerpt || undefined}>
  <div slot="head" style="height:1rem"></div>
  {c.fallback && <p class="muted" role="note">{t.onlyIn(c.shownLang)}</p>}

  {c.kind === "monthly" && <PeriodReturns lang={lang} results={loadResults()} ids={PORTFOLIO_IDS} period={c.period} />}

  <div class={`reading ${toc.length > 1 ? "has-toc" : ""}`}>
    <article class="prose" lang={c.shownLang}>
      {c.filled ? <Content /> : <p class="placeholder">{t.comingSoon}</p>}
    </article>
    {toc.length > 1 && (
      <nav class="toc" aria-label={en ? "In this note" : "En esta nota"}>
        <p class="label">{en ? "In this note" : "En esta nota"}</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    )}
  </div>

  {Object.values(c.portfolios).some(Boolean) && (
    <section>
      <h2>{t.nav.portfolios}</h2>
      <ul>{PORTFOLIO_IDS.filter((id) => c.portfolios[id]).map((id) => (
        <li><a href={href(lang, `portfolios/${id}/`)}>{names[id]}</a>: {c.portfolios[id]}</li>
      ))}</ul>
    </section>
  )}

  <nav class="pager" aria-label={t.nav.commentary}>
    {older ? <a href={href(lang, `commentary/${older.slug}/`)}><span class="muted">{en ? "Previous note" : "Nota anterior"}</span>{fmtPeriod(lang, older.period)}</a> : <span></span>}
    <a class="all" href={href(lang, "commentary/")}>{t.allCommentary}</a>
    {newer ? <a class="nx" href={href(lang, `commentary/${newer.slug}/`)}><span class="muted">{en ? "Next note" : "Nota siguiente"}</span>{fmtPeriod(lang, newer.period)}</a> : <span></span>}
  </nav>
</Base>
<style>
  .reading { display: grid; gap: 32px; }
  @media (min-width: 1000px) { .reading.has-toc { grid-template-columns: minmax(0, 1fr) 240px; gap: 72px; } }
  .toc { align-self: start; }
  @media (min-width: 1000px) { .toc { position: sticky; top: 32px; } }
  @media (max-width: 999px) { .toc { display: none; } }
  .toc ol { list-style: none; padding: 0; margin: 10px 0 0; border-left: 1px solid var(--line); }
  .toc li a { display: block; padding: 6px 0 6px 14px; margin-left: -1px; border-left: 2px solid transparent; font-size: 0.9rem; color: var(--text-2); text-decoration: none; }
  .toc li a:hover { color: var(--accent-ink); border-left-color: var(--accent); }
  .toc li a.on { color: var(--ink); border-left-color: var(--accent); }
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 24px; margin-top: 4.5rem; padding-top: 22px; border-top: 1px solid var(--line); }
  .pager a { display: flex; flex-direction: column; text-decoration: none; font-size: 1.25rem; font-weight: 300; color: var(--ink); }
  .pager a:hover { color: var(--accent-ink); }
  .pager .nx { text-align: right; justify-self: end; }
  .pager a.all { font-size: 0.9rem; font-weight: 400; color: var(--accent-ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 640px) {
    .pager { grid-template-columns: 1fr 1fr; }
    .pager a.all { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
  }
  .pager .muted { font-size: 11px; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; }
</style>
<script>
  // Highlight the section being read in the side index.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  if (links.length && "IntersectionObserver" in window) {
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) {
        links.forEach((a) => a.classList.remove("on"));
        byId.get(e.target.id)?.classList.add("on");
      }
    }, { rootMargin: "0px 0px -70% 0px" });
    byId.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h); });
  }
</script>
