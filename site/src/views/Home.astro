---
import Base from "../layouts/Base.astro";
import Spectrum from "../components/Spectrum.astro";
import { T, href, fmtPeriod, fmtDate } from "../lib/i18n.js";
import { loadPortfolios, loadResults } from "../lib/data.js";
import { listCommentary } from "../lib/content.js";
interface Props { lang: "en" | "es" }
const { lang } = Astro.props;
const t = T[lang];
const results = loadResults();
const latest = listCommentary(lang).find((c) => c.filled);
const copy = lang === "en" ? {
  h1: "Five model portfolios, from all bonds to all equity.",
  lede: "Each one is measured every month against a passive mix with the same share of equity. Decisions are recorded publicly before they take effect.",
  how: "How the portfolios are run",
  points: [
    ["Fixed weights", "Each portfolio has target weights per fund and returns to them at every month end, so the result reflects the allocation, not timing."],
    ["Decisions on record", "The weights live in a public repository. A change is committed before it applies, with its date, so it can't be rewritten after the fact."],
    ["A fair yardstick", "The benchmark holds the same share of equity as the portfolio, in a world equity ETF, and the rest in short-dated euro government and corporate bonds."],
  ],
  latest: "Latest commentary", all: "Read all commentary",
} : {
  h1: "Cinco carteras modelo, de todo bonos a todo bolsa.",
  lede: "Cada una se mide cada mes frente a una combinación pasiva con su mismo peso en renta variable. Las decisiones se registran públicamente antes de entrar en vigor.",
  how: "Cómo se gestionan las carteras",
  points: [
    ["Pesos fijos", "Cada cartera tiene pesos objetivo por fondo y vuelve a ellos a cada fin de mes, de modo que el resultado refleja la asignación y no el momento de entrada."],
    ["Decisiones registradas", "Los pesos están en un repositorio público. Un cambio se registra antes de aplicarse, con su fecha, así que no se puede reescribir después."],
    ["Una vara de medir justa", "El benchmark tiene el mismo peso en renta variable que la cartera, en un ETF de bolsa mundial, y el resto en bonos en euros de gobierno y empresa a corto plazo."],
  ],
  latest: "Último comentario", all: "Leer todos los comentarios",
};
---
<Base lang={lang} heading={copy.h1} lede={copy.lede}>
  <Spectrum lang={lang} portfolios={loadPortfolios()} results={results} />
  <p class="muted note">{t.estimatedNote(fmtDate(lang, results.base_date), fmtDate(lang, results.live_start))}
    {" "}<a href={href(lang, "methodology/")}>{t.nav.methodology}</a></p>

  <h2>{copy.how}</h2>
  <div class="points">
    {copy.points.map(([h, p]) => <div><h3>{h}</h3><p>{p}</p></div>)}
  </div>

  <h2>{copy.latest}</h2>
  {latest
    ? <p class="latest"><a href={href(lang, `commentary/${latest.slug}/`)}>{latest.title || fmtPeriod(lang, latest.period)}</a>
        <span class="muted">{fmtPeriod(lang, latest.period)}</span></p>
    : <p class="placeholder">{t.comingSoon}</p>}
  <p><a href={href(lang, "commentary/")}>{copy.all}</a></p>
</Base>
<style>
  .note { margin-top: 1.25rem; max-width: 80ch; }
  .points { display: grid; gap: 28px; }
  @media (min-width: 760px) { .points { grid-template-columns: repeat(3, 1fr); gap: 44px; } }
  .points p { color: var(--text-2); margin: 0; }
  .latest { display: flex; flex-direction: column; gap: 2px; }
  .latest a { font-family: var(--serif); font-size: 1.35rem; text-decoration: none; }
</style>
