---
import Base from "../layouts/Base.astro";
import PerfChart from "../components/PerfChart.astro";
import Composition from "../components/Composition.astro";
import { T, href, pct, fmtDate, fmtPeriod, weight } from "../lib/i18n.js";
import { loadPortfolios, loadResults, loadInstruments, composition, PORTFOLIO_IDS } from "../lib/data.js";
import { listCommentary, getEditorial } from "../lib/content.js";
interface Props { lang: "en" | "es"; id: string }
const { lang, id } = Astro.props;
const t = T[lang];
const all = loadPortfolios();
const p = all.find((x) => x.id === id)!;
const results = loadResults();
const r = results.portfolios[id];
const n = r?.dates?.length ?? 0;
const ins = loadInstruments();
const ed = getEditorial(lang);
const mentions = listCommentary(lang).filter((c) => c.portfolios?.[id]);
const sign = (x: number) => (x > 0 ? "pos" : x < 0 ? "neg" : "");
let ytd = null as null | { p: number; b: number; asof: string; estimated: boolean };
if (n >= 2) {
  const year = r.dates[n - 1].slice(0, 4);
  const i = Math.max(r.dates.findLastIndex((d: string) => d < `${year}-01-01`), 0);
  ytd = { p: r.portfolio[n - 1] / r.portfolio[i] - 1, b: r.benchmark[n - 1] / r.benchmark[i] - 1,
          asof: r.dates[n - 1], estimated: r.dates[n - 1] <= results.live_start };
}
const benchNames: Record<string, string> = { IE00B6R52259: "MSCI ACWI", IE00B3VTMJ91: "€ Govt Bond 1-3yr", IE00BH04FZ00: "EUR Corporate 1-3yr" };
const idx = PORTFOLIO_IDS.indexOf(id);
const prev = all[idx - 1], next = all[idx + 1];
const kicker = lang === "en"
  ? `Model portfolio with ${p.equity}% equity and ${p.fixedIncome}% fixed income`
  : `Cartera modelo con un ${p.equity} % de renta variable y un ${p.fixedIncome} % de renta fija`;
---
<Base lang={lang} title={p.name} path={`portfolios/${id}/`} kicker={kicker} heading={p.name}>
  {ytd && (
    <div slot="head" class="stats">
      <p class="hero-num">{pct(lang, ytd.p)}</p>
      <dl>
        <div><dt>{lang === "en" ? "Return this year" : "Rentabilidad en el año"}</dt>
             <dd>{lang === "en" ? "to" : "a"} {fmtDate(lang, ytd.asof)}{ytd.estimated ? ` (${t.estimated.toLowerCase()})` : ""}</dd></div>
        <div><dt>{t.benchmark}</dt><dd>{pct(lang, ytd.b)}</dd></div>
        <div><dt>{t.difference}</dt><dd class={sign(ytd.p - ytd.b)}>{pct(lang, ytd.p - ytd.b)}</dd></div>
      </dl>
    </div>
  )}

  {n >= 2
    ? <PerfChart lang={lang} data={r} liveStart={results.live_start} name={p.name} />
    : (
      <div class="chart-empty">
        <p class="ce-title">{t.chartTitle}</p>
        <p>{lang === "en"
          ? `The chart appears once the first close is calculated: the estimated year to date to ${fmtDate(lang, results.live_start)}, then one point per month end.`
          : `El gráfico aparece cuando se calcule el primer cierre: el año estimado hasta el ${fmtDate(lang, results.live_start)} y después un punto por cada fin de mes.`}</p>
      </div>
    )}
  <p class="muted">{t.estimatedNote(fmtDate(lang, results.base_date), fmtDate(lang, results.live_start))}</p>

<div class="two">
    <section>
      <h2>{t.composition}</h2>
      <Composition lang={lang} blocks={composition(p, ins)} fundNotes={ed.funds} blockNotes={ed.blocks} />
    </section>
    <aside>
      <h2>{t.benchmarkMix}</h2>
      <ul class="bench">
        {Object.entries(p.benchmark).filter(([, w]) => (w as number) > 0).map(([isin, w]) => (
          <li><span class="figure bw">{weight(lang, w as number)}</span>
              <span><strong>{benchNames[isin]}</strong><br /><span class="muted">{ins.benchmarks[isin].name}</span></span></li>
        ))}
      </ul>
      <p class="muted"><a href={href(lang, "methodology/")}>{lang === "en" ? "How the benchmark is built" : "Cómo se construye el benchmark"}</a></p>

      <h2>{t.commentary}</h2>
      {ed.portfolios?.[id]
        ? <p>{ed.portfolios[id]}</p>
        : <p class="placeholder">{t.comingSoon}</p>}
      {mentions.length > 0 && (
        <ul class="mentions">{mentions.map((c) => (
          <li><a href={href(lang, `commentary/${c.slug}/`)}>{fmtPeriod(lang, c.period)}</a>: {c.portfolios[id]}</li>
        ))}</ul>
      )}
    </aside>
  </div>

  <nav class="pager" aria-label={t.nav.portfolios}>
    {prev ? <a href={href(lang, `portfolios/${prev.id}/`)}><span class="muted">{lang === "en" ? "Less equity" : "Menos renta variable"}</span>{prev.name}</a> : <span></span>}
    {next ? <a class="nx" href={href(lang, `portfolios/${next.id}/`)}><span class="muted">{lang === "en" ? "More equity" : "Más renta variable"}</span>{next.name}</a> : <span></span>}
  </nav>
</Base>
<style>
  .stats { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 16px 56px; margin: 2rem 0 2.5rem; }
  .hero-num { font-size: clamp(3rem, 8vw, 4rem); line-height: 1; font-weight: 300; color: var(--ink); margin: 0; letter-spacing: -0.02em; }
  dl { display: flex; flex-wrap: wrap; gap: 12px 40px; margin: 0 0 6px; }
  dt { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 4px; }
  dd { margin: 0; font-size: 1.15rem; color: var(--ink); font-variant-numeric: tabular-nums; }
  .chart-empty { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 28px 24px; margin: 0 0 1rem;
                 min-height: 220px; display: flex; flex-direction: column; justify-content: center; }
  .chart-empty p { max-width: 62ch; color: var(--text-2); margin: 0; }
  .chart-empty .ce-title { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.6rem; }
  .two { display: grid; gap: 0 64px; }
  @media (min-width: 900px) { .two { grid-template-columns: 1.7fr 1fr; } }
  .bench { list-style: none; padding: 0; margin: 0 0 1rem; border-top: 1px solid var(--line); }
  .bench li { display: flex; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .bw { font-size: 1.15rem; font-weight: 300; min-width: 4.2rem; color: var(--ink); font-variant-numeric: tabular-nums; }
  .mentions { padding-left: 1.1rem; }
  .pager { display: flex; justify-content: space-between; gap: 24px; margin-top: 4.5rem; padding-top: 22px; border-top: 1px solid var(--line); }
  .pager a { display: flex; flex-direction: column; text-decoration: none; font-size: 1.25rem; font-weight: 300; color: var(--ink); }
  .pager a:hover { color: var(--accent-ink); }
  .pager .nx { text-align: right; }
  .pager .muted { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; }
</style>
