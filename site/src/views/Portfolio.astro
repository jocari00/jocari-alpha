---
import Base from "../layouts/Base.astro";
import PerfChart from "../components/PerfChart.astro";
import Composition from "../components/Composition.astro";
import { T, href, pct, fmtDate, fmtPeriod, weight } from "../lib/i18n.js";
import { loadPortfolios, loadResults, loadInstruments, composition, PORTFOLIO_IDS } from "../lib/data.js";
import { listCommentary, getEditorial } from "../lib/content.js";
interface Props { lang: "en" | "es"; id: string }
const { lang, id } = Astro.props;
const t = T[lang];
const all = loadPortfolios();
const p = all.find((x) => x.id === id)!;
const results = loadResults();
const r = results.portfolios[id];
const n = r?.dates?.length ?? 0;
const ins = loadInstruments();
const ed = getEditorial(lang);
const mentions = listCommentary(lang).filter((c) => c.portfolios?.[id]);
const sign = (x: number) => (x > 0 ? "pos" : x < 0 ? "neg" : "");
let ytd = null as null | { p: number; b: number; asof: string; estimated: boolean };
if (n >= 2) {
  const year = r.dates[n - 1].slice(0, 4);
  const i = Math.max(r.dates.findLastIndex((d: string) => d < `${year}-01-01`), 0);
  ytd = { p: r.portfolio[n - 1] / r.portfolio[i] - 1, b: r.benchmark[n - 1] / r.benchmark[i] - 1,
          asof: r.dates[n - 1], estimated: r.dates[n - 1] <= results.live_start };
}
const benchNames: Record<string, string> = { IE00B6R52259: "MSCI ACWI", IE00B3VTMJ91: "€ Govt Bond 1-3yr", IE00BH04FZ00: "EUR Corporate 1-3yr" };
const idx = PORTFOLIO_IDS.indexOf(id);
const prev = all[idx - 1], next = all[idx + 1];
const eyebrow = `${lang === "en" ? "Model portfolio" : "Cartera modelo"} · ${p.equity} % ${t.equity.toLowerCase()} · ${p.fixedIncome} % ${t.fixedIncome.toLowerCase()}`;
---
<Base lang={lang} title={p.name} path={`portfolios/${id}/`} eyebrow={eyebrow} heading={p.name}>
  <div slot="head" class="stats">
    {ytd ? (<>
      <div><span class="k">{t.ytd}{ytd.estimated ? ` · ${t.estimated}` : ""}</span><span class="v figure">{pct(lang, ytd.p)}</span></div>
      <div><span class="k">{t.benchmark}</span><span class="v figure">{pct(lang, ytd.b)}</span></div>
      <div><span class="k">{t.difference}</span><span class="v figure">{pct(lang, ytd.p - ytd.b)}</span></div>
      <div><span class="k">{lang === "en" ? "As of" : "A fecha"}</span><span class="v small">{fmtDate(lang, ytd.asof)}</span></div>
    </>) : <p class="pend">{t.notValued}</p>}
  </div>

  <div class="lift">
    {n >= 2
      ? <PerfChart lang={lang} data={r} liveStart={results.live_start} name={p.name} />
      : <div class="card empty"><span class="eyebrow">{t.chartTitle}</span><p>{t.pending}</p></div>}
  </div>
  <p class="muted">{t.estimatedNote(fmtDate(lang, results.base_date), fmtDate(lang, results.live_start))}</p>

  <div class="two">
    <section>
      <h2>{t.composition}</h2>
      <Composition lang={lang} blocks={composition(p, ins)} fundNotes={ed.funds} blockNotes={ed.blocks} />
    </section>
    <aside>
      <h2>{t.benchmarkMix}</h2>
      <ul class="bench">
        {Object.entries(p.benchmark).filter(([, w]) => (w as number) > 0).map(([isin, w]) => (
          <li><span class="figure bw">{weight(lang, w as number)}</span>
              <span><strong>{benchNames[isin]}</strong><br /><span class="muted">{ins.benchmarks[isin].name}</span></span></li>
        ))}
      </ul>
      <p class="muted"><a href={href(lang, "methodology/")}>{t.nav.methodology} →</a></p>

      <h2>{t.commentary}</h2>
      {ed.portfolios?.[id]
        ? <p>{ed.portfolios[id]}</p>
        : <p class="placeholder">{t.comingSoon}</p>}
      {mentions.length > 0 && (
        <ul class="mentions">{mentions.map((c) => (
          <li><a href={href(lang, `commentary/${c.slug}/`)}>{fmtPeriod(lang, c.period)}</a> — {c.portfolios[id]}</li>
        ))}</ul>
      )}
    </aside>
  </div>

  <nav class="pager" aria-label={t.nav.portfolios}>
    {prev ? <a href={href(lang, `portfolios/${prev.id}/`)}>← {prev.name}</a> : <span></span>}
    {next ? <a href={href(lang, `portfolios/${next.id}/`)}>{next.name} →</a> : <span></span>}
  </nav>
</Base>
<style>
  .stats { display: flex; flex-wrap: wrap; gap: 20px 48px; margin-top: 1.75rem; padding-bottom: 3.5rem; }
  .stats div { display: flex; flex-direction: column; }
  .k { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--on-navy-2); }
  .v { font-size: clamp(1.7rem, 4vw, 2.4rem); color: var(--on-navy); line-height: 1.2; }
  .v.small { font-family: var(--font); font-size: 1rem; margin-top: auto; }
  .pend { color: var(--on-navy-2); margin: 0; }
  .lift { margin-top: -3.5rem; position: relative; z-index: 1; }
  .lift :global(.perf) { margin-top: 0; box-shadow: 0 10px 30px rgb(11 31 58 / 0.08); }
  .empty { padding: 36px 28px; }
  .empty p { margin: 0.5rem 0 0; color: var(--text-2); max-width: 60ch; }
  .two { display: grid; gap: 0 56px; }
  @media (min-width: 900px) { .two { grid-template-columns: 1.7fr 1fr; } }
  .bench { list-style: none; padding: 0; margin: 0 0 1rem; border-top: 1px solid var(--line); }
  .bench li { display: flex; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .bw { font-size: 1.3rem; min-width: 4.2rem; color: var(--accent-ink); }
  .mentions { padding-left: 1.1rem; }
  .pager { display: flex; justify-content: space-between; margin-top: 4rem; padding-top: 20px; border-top: 1px solid var(--line);
           font-family: var(--serif); font-size: 1.1rem; }
  .pager a { text-decoration: none; color: var(--text); }
  .pager a:hover { color: var(--accent-ink); }
</style>
