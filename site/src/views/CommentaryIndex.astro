---
import Base from "../layouts/Base.astro";
import { T, href, fmtPeriod, fmtDate } from "../lib/i18n.js";
import { listCommentary, periodShort, kindLabel } from "../lib/content.js";
interface Props { lang: "en" | "es" }
const { lang } = Astro.props;
const t = T[lang];
const en = lang === "en";
const items = listCommentary(lang);
// Group by year, newest first (items already come newest first).
const years: [string, typeof items][] = [];
for (const c of items) {
  const y = String(c.period).slice(0, 4);
  const g = years.find(([k]) => k === y);
  g ? g[1].push(c) : years.push([y, [c]]);
}
---
<Base lang={lang} title={t.nav.commentary} path="commentary/" heading={t.nav.commentary}
      lede={en ? "A note at each month end on what moved the portfolios, plus quarterly notes for 2026 before tracking began."
               : "Una nota a cada fin de mes sobre qué movió las carteras, más notas trimestrales de 2026 anteriores al seguimiento."}>
  <div slot="head" style="height:1rem"></div>
  {years.map(([year, list]) => (
    <section class="year">
      <h2>{year}</h2>
      <ol class="cards">
        {list.map((c) => { const s = periodShort(lang, c.period); return (
          <li>
            <a class={`card ${c.filled ? "" : "soon"}`} href={href(lang, `commentary/${c.slug}/`)} aria-label={`${fmtPeriod(lang, c.period)}${c.title ? `: ${c.title}` : ""}`}>
              <span class="top">
                <span class="label">{kindLabel(lang, c.kind)}</span>
                <span class={`status ${c.filled ? "on" : ""}`}>{c.filled ? (en ? "Published" : "Publicado") : (en ? "Coming soon" : "Próximamente")}</span>
              </span>
              <span class="period"><span class="big">{s.big}</span><span class="yr">{s.year}</span></span>
              <span class="title">{c.title || (en ? "What moved the portfolios this month" : "Qué movió las carteras este mes")}</span>
              {c.filled && c.excerpt && <span class="excerpt">{c.excerpt}</span>}
              {c.written && <span class="meta">{t.written} {fmtDate(lang, c.written)}</span>}
            </a>
          </li>); })}
      </ol>
    </section>
  ))}
</Base>
<style>
  .year { margin-top: 2.5rem; }
  .year h2 { font-size: 1rem; font-weight: 500; color: var(--muted); margin: 0 0 14px; padding-bottom: 10px; border-bottom: 1px solid var(--line); }
  .cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  @media (min-width: 700px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .cards { grid-template-columns: repeat(3, 1fr); } }
  .card { display: flex; flex-direction: column; gap: 10px; height: 100%; box-sizing: border-box; padding: 20px 22px 22px;
          border: 1px solid var(--line); border-radius: 4px; background: var(--surface); color: var(--text); text-decoration: none;
          transition: border-color 150ms; }
  .card:hover, .card:focus-visible { border-color: var(--accent); }
  .card:hover .title, .card:focus-visible .title { color: var(--accent-ink); }
  .top { display: flex; justify-content: space-between; gap: 12px; }
  .status { font-size: 0.8rem; color: var(--muted); }
  .status::before { content: ""; display: inline-block; width: 7px; height: 7px; border-radius: 50%; border: 1px solid var(--muted); margin-right: 7px; vertical-align: 1px; }
  .status.on::before { background: var(--accent); border-color: var(--accent); }
  .period { display: flex; align-items: flex-end; gap: 10px; margin-top: 8px; }
  .big { font-size: 3.4rem; font-weight: 300; line-height: 0.85; letter-spacing: -0.04em; color: var(--ink); }
  .yr { font-size: 0.85rem; color: var(--muted); padding-bottom: 3px; }
  .title { font-size: 1.15rem; font-weight: 400; line-height: 1.3; color: var(--ink); }
  .excerpt { font-size: 0.9rem; line-height: 1.55; color: var(--text-2); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .meta { font-size: 0.8rem; color: var(--muted); margin-top: auto; }
  .soon .title { color: var(--text-2); }
</style>
