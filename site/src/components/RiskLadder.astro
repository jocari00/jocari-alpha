---
// The five profiles as equity / fixed-income bars (a part-to-whole of two values per row).
import { T, href } from "../lib/i18n.js";
interface Props { lang: "en" | "es"; portfolios: { id: string; name: string; equity: number; fixedIncome: number }[] }
const { lang, portfolios } = Astro.props;
const t = T[lang];
---
<div class="ladder">
  <ul class="legend">
    <li><span class="sw sw-eq" aria-hidden="true"></span>{t.equity}</li>
    <li><span class="sw sw-fi" aria-hidden="true"></span>{t.fixedIncome}</li>
  </ul>
  <ol>
    {portfolios.map((p) => (
      <li>
        <a href={href(lang, `portfolios/${p.id}/`)} class="name">{p.name}</a>
        <div class="bar" role="img" aria-label={`${p.name}: ${t.equity} ${p.equity} %, ${t.fixedIncome} ${p.fixedIncome} %`}>
          {p.equity > 0 && <span class="eq" style={`width:${p.equity}%`}></span>}
          {p.fixedIncome > 0 && <span class="fi" style={`width:${p.fixedIncome}%`}></span>}
        </div>
        <span class="vals">{p.equity} / {p.fixedIncome}</span>
      </li>
    ))}
  </ol>
  <p class="muted">{t.ladderNote}</p>
</div>
<style>
  .legend { display: flex; gap: 18px; list-style: none; padding: 0; margin: 0 0 10px; font-size: 0.875rem; color: var(--text-2); }
  .legend li { display: flex; align-items: center; gap: 6px; }
  .sw { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
  .sw-eq, .eq { background: var(--series-1); }
  .sw-fi, .fi { background: color-mix(in srgb, var(--series-1) 28%, var(--surface)); }
  ol { list-style: none; padding: 0; margin: 0 0 8px; display: grid; gap: 10px; }
  li { display: grid; grid-template-columns: 8.5rem 1fr 4.5rem; align-items: center; gap: 12px; }
  .name { color: var(--text); font-weight: 600; text-decoration: none; }
  .name:hover { text-decoration: underline; }
  .bar { display: flex; gap: 2px; height: 14px; }
  .bar span:first-child { border-radius: 4px 0 0 4px; } .bar span:last-child { border-radius: 0 4px 4px 0; }
  .bar span:only-child { border-radius: 4px; }
  .vals { font-variant-numeric: tabular-nums; color: var(--text-2); font-size: 0.875rem; text-align: right; }
  @media (max-width: 520px) { li { grid-template-columns: 6.5rem 1fr 3.8rem; gap: 8px; } }
</style>
