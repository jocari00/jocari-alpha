---
// The risk ladder as the page's signature: five columns whose equity share climbs from 0% to
// 100%, each with its year-to-date return against its benchmark. Columns on wide screens,
// rows on phones. The bars grow once on load (skipped with prefers-reduced-motion).
import { T, href, pct } from "../lib/i18n.js";
interface Props { lang: "en" | "es"; portfolios: any[]; results: any }
const { lang, portfolios, results } = Astro.props;
const t = T[lang];
const sign = (x: number) => (x > 0 ? "pos" : x < 0 ? "neg" : "");
const rows = portfolios.map((p) => {
  const r = results.portfolios[p.id];
  const n = r?.dates?.length ?? 0;
  if (n < 2) return { ...p, valued: false };
  const year = r.dates[n - 1].slice(0, 4);
  const i = Math.max(r.dates.findLastIndex((d: string) => d < `${year}-01-01`), 0);
  const pr = r.portfolio[n - 1] / r.portfolio[i] - 1, br = r.benchmark[n - 1] / r.benchmark[i] - 1;
  return { ...p, valued: true, pr, br, x: pr - br };
});
const label = (eq: number) => lang === "en" ? `${eq}% equity` : `${eq} % renta variable`;
---
<ol class="spectrum" aria-label={t.ladder}>
  {rows.map((p, i) => (
    <li style={`--i:${i}`}>
      <a href={href(lang, `portfolios/${p.id}/`)}>
        <span class="name">{p.name}</span>
        <span class="mix">{label(p.equity)}</span>
        <span class="col" role="img" aria-label={`${t.equity} ${p.equity} %, ${t.fixedIncome} ${p.fixedIncome} %`}>
          {p.fixedIncome > 0 && <span class="fi" style={`flex:${p.fixedIncome}`}></span>}
          {p.equity > 0 && <span class="eq" style={`flex:${p.equity}`}></span>}
        </span>
        {p.valued ? (
          <span class="nums">
            <span class="ytd">{pct(lang, p.pr)}</span>
            <span class="bm">{t.benchmark} {pct(lang, p.br)}</span>
            <span class="dx">{t.difference} <span class={sign(p.x)}>{pct(lang, p.x)}</span></span>
          </span>
        ) : <span class="nums wait">{t.notValued}</span>}
      </a>
    </li>
  ))}
</ol>
<p class="key">
  <span><i class="k-eq"></i>{t.equity}</span>
  <span><i class="k-fi"></i>{t.fixedIncome}</span>
  <span>{lang === "en" ? "Figures are year to date." : "Cifras en lo que va de año."}</span>
</p>

<style>
  .spectrum { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; grid-template-columns: repeat(5, 1fr);
              border-top: 1px solid var(--line); }
  .spectrum li + li { border-left: 1px solid var(--line); }
  .spectrum a { display: flex; flex-direction: column; height: 100%; padding: 20px 18px 22px; color: var(--text); text-decoration: none; }
  .spectrum a:hover .name { color: var(--accent-ink); }
  .name { font-family: var(--serif); font-size: 1.25rem; color: var(--ink); }
  .mix { font-size: 0.82rem; color: var(--muted); margin-bottom: 18px; }
  .col { display: flex; flex-direction: column; gap: 2px; height: 220px; margin-bottom: 18px; }
  .fi { background: var(--fi); border-radius: 3px 3px 0 0; }
  .eq { background: var(--series-1); border-radius: 3px 3px 0 0; }
  .fi + .eq { border-radius: 0; }
  .nums { display: flex; flex-direction: column; gap: 2px; margin-top: auto; }
  .ytd { font-size: 1.55rem; line-height: 1.2; color: var(--ink); font-weight: 500; }
  .bm { font-size: 0.85rem; color: var(--text-2); }
  .dx { font-size: 0.85rem; color: var(--text-2); }
  .wait { font-size: 0.85rem; color: var(--muted); }
  .key { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 14px; font-size: 0.82rem; color: var(--muted); }
  .key i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 7px; vertical-align: -1px; }
  .k-eq { background: var(--series-1); } .k-fi { background: var(--fi); }

  /* One orchestrated moment: the columns rise in sequence on load. */
  @media (prefers-reduced-motion: no-preference) {
    .col { transform-origin: bottom; animation: rise 700ms cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i) * 90ms); }
    @keyframes rise { from { transform: scaleY(0.04); opacity: 0.4; } to { transform: none; opacity: 1; } }
  }

  /* Phones: one row per portfolio, the column becomes a horizontal bar. */
  @media (max-width: 720px) {
    .spectrum { grid-template-columns: 1fr; }
    .spectrum li + li { border-left: 0; border-top: 1px solid var(--line); }
    .spectrum a { display: grid; grid-template-columns: 1fr auto; grid-template-areas: "name nums" "mix nums" "col col";
                  gap: 0 16px; padding: 16px 0; }
    .name { grid-area: name; } .mix { grid-area: mix; margin-bottom: 10px; }
    .nums { grid-area: nums; align-items: flex-end; text-align: right; }
    .col { grid-area: col; flex-direction: row-reverse; height: 8px; margin: 0; }
    .fi, .eq, .fi + .eq { border-radius: 2px; }
    .ytd { font-size: 1.3rem; }
    @media (prefers-reduced-motion: no-preference) {
      .col { transform-origin: left; animation-name: grow; }
      @keyframes grow { from { transform: scaleX(0.04); } to { transform: none; } }
    }
  }
</style>
