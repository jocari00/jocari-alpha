---
// Target weights by block and by fund (weights are static, so current = target).
import { T, weight, blockLabel } from "../lib/i18n.js";
interface Props { lang: "en" | "es"; blocks: any[]; fundNotes: Record<string, string>; blockNotes: Record<string, string> }
const { lang, blocks, fundNotes, blockNotes } = Astro.props;
const t = T[lang];
const max = Math.max(...blocks.map((b) => b.weight));
---
<div class="comp">
  <p class="muted">{t.staticWeights}</p>
  {blocks.map((b) => (
    <section class="block">
      <div class="row head">
        <h3>{blockLabel(lang, b.block, b.label)} <span class="tag">{b.asset_class === "equity" ? t.equity : t.fixedIncome}</span></h3>
        <span class="w">{weight(lang, b.weight)}</span>
      </div>
      <div class="bar" aria-hidden="true"><span style={`width:${(b.weight / max) * 100}%`}></span></div>
      <p class={blockNotes?.[b.block] ? "note" : "note placeholder"}>{blockNotes?.[b.block] || t.comingSoon}</p>
      <table>
        <caption class="sr">{t.byFund}</caption>
        <tbody>
          {b.funds.map((f: any) => (
            <tr>
              <td>{f.name}<span class="muted"> · {f.share_class} · {f.isin}</span>
                {fundNotes?.[f.isin] && <div class="note">{fundNotes[f.isin]}</div>}</td>
              <td class="num">{weight(lang, f.weight)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
</div>
<style>
  .block { margin: 0 0 1.5rem; }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  h3 { margin: 0.5rem 0 0.4rem; font-family: var(--font); font-size: 1rem; }
  .w { font-variant-numeric: tabular-nums; font-weight: 600; }
  .bar { height: 6px; background: var(--surface-2); border-radius: 4px; margin-bottom: 8px; }
  .bar span { display: block; height: 100%; background: var(--series-1); border-radius: 4px; }
  .note { font-size: 0.9rem; color: var(--text-2); margin: 0.25rem 0 0.5rem; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  td { padding: 6px 8px; }
</style>
