---
// Target weights of every fund in every portfolio: portfolios in columns, funds in rows,
// grouped by block with a subtotal row per block. Zero weights show as a dash.
import { T, blockLabel, weight } from "../lib/i18n.js";
interface Props { lang: "en" | "es"; portfolios: any[]; instruments: any }
const { lang, portfolios, instruments } = Astro.props;
const t = T[lang];
const order = Object.keys(instruments.blocks);
const blocks = order.map((block) => {
  const funds = Object.values(instruments.funds as Record<string, any>)
    .filter((f) => f.block === block && portfolios.some((p) => p.weights[f.isin]));
  const total = (p: any) => funds.reduce((s, f) => s + (p.weights[f.isin] ?? 0), 0);
  return { block, label: blockLabel(lang, block, instruments.blocks[block].label),
           asset: instruments.blocks[block].asset_class, funds, totals: portfolios.map(total) };
}).filter((b) => b.funds.length);
const w = (x: number) => (x ? weight(lang, x) : "–");
---
<div class="matrix-scroll" tabindex="0" role="region" aria-label={lang === "en" ? "Target weights by portfolio" : "Pesos objetivo por cartera"}>
  <table class="matrix">
    <thead>
      <tr>
        <th scope="col" class="fund-col">{lang === "en" ? "Fund" : "Fondo"}</th>
        {portfolios.map((p) => <th scope="col" class="num">{p.name}</th>)}
      </tr>
    </thead>
    {blocks.map((b) => (
      <tbody>
        <tr class="block-row">
          <th scope="rowgroup" class="fund-col">{b.label}
            <span class="asset">{b.asset === "equity" ? t.equity : t.fixedIncome}</span></th>
          {b.totals.map((x) => <td class="num">{w(x)}</td>)}
        </tr>
        {b.funds.map((f: any) => (
          <tr class="fund-row">
            <th scope="row" class="fund-col">{f.name} <span class="cls">{f.share_class}</span></th>
            {portfolios.map((p) => <td class={`num ${p.weights[f.isin] ? "" : "zero"}`}>{w(p.weights[f.isin] ?? 0)}</td>)}
          </tr>
        ))}
      </tbody>
    ))}
    <tfoot>
      <tr>
        <th scope="row" class="fund-col">{t.equity} / {t.fixedIncome}</th>
        {portfolios.map((p) => <td class="num">{p.equity} / {p.fixedIncome}</td>)}
      </tr>
    </tfoot>
  </table>
</div>

<style>
  .matrix-scroll { overflow-x: auto; margin: 0 -16px; padding: 0 16px; }
  .matrix-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .matrix { min-width: 760px; font-size: 0.9rem; }
  .matrix th, .matrix td { padding: 9px 12px; border-bottom: 1px dashed var(--line); }
  .matrix thead th { font-size: 0.85rem; color: var(--ink); font-weight: 600; border-bottom: 1px solid var(--ink); white-space: nowrap; }
  .fund-col { text-align: left; position: sticky; left: 0; background: var(--bg); min-width: 280px; }
  .block-row th, .block-row td { background: var(--surface-2); font-weight: 600; color: var(--ink);
                                 border-bottom: 1px solid var(--line); border-top: 1px solid var(--line); }
  .block-row th { font-weight: 600; }
  .asset { display: block; font-weight: 400; font-size: 0.78rem; color: var(--muted); }
  .fund-row th { font-weight: 400; padding-left: 24px; color: var(--text); }
  .cls { color: var(--muted); font-size: 0.85em; }
  .zero { color: var(--muted); }
  tfoot th, tfoot td { font-weight: 600; color: var(--ink); border-top: 1px solid var(--ink); border-bottom: 0; }
  @media (max-width: 720px) { .fund-col { min-width: 210px; } }
</style>
