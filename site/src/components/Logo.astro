---
// Jocari Alpha mark: a J and an alpha joined by one top bar, inside a seal.
// Colours follow the theme (accent tile, on-accent strokes).
interface Props { size?: number; label?: string }
const { size = 30, label } = Astro.props;
---
<svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" role={label ? "img" : undefined}
     aria-label={label} aria-hidden={label ? undefined : "true"}>
  <rect width="32" height="32" rx="5" fill="var(--accent)" />
  <g transform="translate(2.2 2.4) scale(.86)" fill="none" stroke="var(--on-accent)" stroke-width="2.5"
     stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 6.5H27" />
    <path d="M12 6.5V20c0 3.2-2 5-4.6 5-1.6 0-2.8-.8-3.4-2" />
    <path d="M27.5 13.2c-1.3 5.3-3.6 11.3-8 11.3-2.6 0-3.9-2.1-3.9-4.8 0-3.6 2.2-6.6 4.9-6.6 2.6 0 3.8 2.6 4.6 5.6.7 2.6 1.6 5.3 3.3 5.3" />
  </g>
</svg>
<style>.logo-mark { flex: none; display: block; }</style>
