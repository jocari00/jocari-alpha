---
// Auto-filled block for a monthly commentary: each portfolio vs its benchmark over the month.
import { T, pct, pp, href, fmtDate } from "../lib/i18n.js";
import { loadPortfolios } from "../lib/data.js";
interface Props { lang: "en" | "es"; results: any; ids: string[]; period: string }
const { lang, results, ids, period } = Astro.props;
const t = T[lang];
const sign = (x: number) => (x > 0 ? "pos" : x < 0 ? "neg" : "");
// The period whose end falls in this month (for October 2026: the estimated YTD to 30 Oct).
const names = Object.fromEntries(loadPortfolios().map((p) => [p.id, p.name]));
const rows = ids.map((id) => {
  const r = results.portfolios[id];
  const per = r?.periods?.find((x: any) => x.to.slice(0, 7) === period);
  return { id, name: names[id], per };
});
const any = rows.some((r) => r.per);
// The estimated period runs from the base date, so it is a year to date, not a month.
const first = rows.find((r) => r.per)?.per;
const heading = first?.type === "estimated" ? `${t.ytdTo} ${fmtDate(lang, first.to)}` : t.monthReturns;
const span = first ? `${fmtDate(lang, first.from)} – ${fmtDate(lang, first.to)}` : "";
---
{any && (
  <section class="card period">
    <h2>{heading}</h2>
    <p class="span muted">{span}</p>
    <div class="table-scroll">
      <table>
        <thead><tr><th scope="col">{t.nav.portfolios}</th><th class="num">{t.portfolio}</th><th class="num">{t.benchmark}</th><th class="num">{t.difference}</th></tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <td><a href={href(lang, `portfolios/${r.id}/`)}>{r.name}</a></td>
              {r.per ? (<>
                <td class="num">{pct(lang, r.per.portfolio)}</td>
                <td class="num">{pct(lang, r.per.benchmark)}</td>
                <td class={`num ${sign(r.per.excess)}`}>{pp(lang, r.per.excess)}</td>
              </>) : <td colspan="3" class="placeholder">{t.notValued}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}
<style>.period { margin: 1.5rem 0; } .period h2 { margin-top: 0; margin-bottom: 4px; font-size: 1.15rem; } .period .span { margin: 0 0 12px; font-size: .875rem; font-variant-numeric: tabular-nums; }</style>
