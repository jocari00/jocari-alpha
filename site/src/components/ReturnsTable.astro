---
// Latest figures for every portfolio vs its benchmark (since the base, YTD).
import { T, href, pct, fmtDate } from "../lib/i18n.js";
import { loadPortfolios } from "../lib/data.js";
interface Props { lang: "en" | "es"; results: any; ids: string[] }
const { lang, results, ids } = Astro.props;
const t = T[lang];
const sign = (x: number) => (x > 0 ? "pos" : x < 0 ? "neg" : "");
const names = Object.fromEntries(loadPortfolios().map((p) => [p.id, p.name]));
const rows = ids.map((id) => {
  const r = results.portfolios[id];
  const n = r?.dates?.length ?? 0;
  if (n < 2) return { id, name: names[id], valued: false };
  const p = r.portfolio[n - 1] / 100 - 1, b = r.benchmark[n - 1] / 100 - 1;
  return { id, name: r.name, valued: true, p, b, x: p - b, asof: r.dates[n - 1],
           estimated: r.dates[n - 1] <= results.live_start };
});
const asof = rows.find((r) => r.valued)?.asof;
---
<div class="table-scroll">
  <table>
    <caption class="muted">{t.sinceStart}{asof ? (lang === "en" ? ` to ${fmtDate(lang, asof)}` : ` hasta el ${fmtDate(lang, asof)}`) : ""}</caption>
    <thead><tr><th scope="col">{t.nav.portfolios}</th><th class="num">{t.portfolio}</th><th class="num">{t.benchmark}</th><th class="num">{t.difference}</th><th></th></tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>
          <td><a href={href(lang, `portfolios/${r.id}/`)}>{r.name}</a></td>
          {r.valued ? (<>
            <td class="num">{pct(lang, r.p)}</td>
            <td class="num">{pct(lang, r.b)}</td>
            <td class={`num ${sign(r.x)}`}>{pct(lang, r.x)}</td>
            <td>{r.estimated && <span class="tag">{t.estimated}</span>}</td>
          </>) : <td colspan="4" class="placeholder">{t.notValued}</td>}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<style>caption { text-align: left; caption-side: top; padding-bottom: 6px; }</style>
