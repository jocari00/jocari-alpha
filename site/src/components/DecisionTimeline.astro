---
// Decision log as a vertical timeline: effective date, what was decided, and the commit that
// recorded it (linked to GitHub) as proof of when it was written. Defaults to the model
// portfolios' log; My portfolio passes its own.
import { fmtDate } from "../lib/i18n.js";
import { loadDecisionLog } from "../lib/data.js";
interface Props { lang: "en" | "es"; log?: any[] }
const { lang } = Astro.props;
const en = lang === "en";
const log = Astro.props.log ?? loadDecisionLog();
const REPO = "https://github.com/jocari00/jocari-alpha";
const kindLabel = (k: string) => ({ initial: en ? "Initial allocation" : "Asignación inicial",
  rebalance: en ? "Rebalance" : "Rebalanceo", change: en ? "Weight change" : "Cambio de pesos" } as Record<string, string>)[k] ?? k;
---
<ol class="timeline">
  {log.map((d, i) => (
    <li class={i === 0 ? "latest" : ""}>
      <span class="node" aria-hidden="true"></span>
      <span class="when">{fmtDate(lang, d.date, { day: "numeric", month: "short", year: "numeric" })}</span>
      <span class="what">{kindLabel(d.kind)}</span>
      {d.portfolios.length > 0 && <span class="who">{d.portfolios.length === 5 ? (en ? "All five portfolios" : "Las cinco carteras") : d.portfolios.join(", ")}</span>}
      {d.commit && (
        <a class="proof" href={`${REPO}/commit/${d.commit.hash}`} rel="noopener">
          {en ? "Recorded" : "Registrado"} {fmtDate(lang, d.commit.date)} <code>{d.commit.short}</code>
        </a>
      )}
    </li>
  ))}
  <li class="next">
    <span class="node" aria-hidden="true"></span>
    <span class="what muted-what">{en ? "Next decision" : "Próxima decisión"}</span>
    <span class="who">{en ? "Committed here before it takes effect" : "Se registrará aquí antes de entrar en vigor"}</span>
  </li>
</ol>
<style>
  .timeline { list-style: none; margin: 0; padding: 0 0 0 28px; position: relative; }
  .timeline::before { content: ""; position: absolute; left: 7px; top: 8px; bottom: 8px; width: 2px; background: var(--line); }
  .timeline li { position: relative; display: flex; flex-direction: column; gap: 3px; padding: 0 0 28px; }
  .node { position: absolute; left: -28px; top: 3px; width: 16px; height: 16px; border-radius: 50%; background: var(--bg); border: 2px solid var(--accent); }
  .latest .node { background: var(--accent); box-shadow: 0 0 0 5px color-mix(in srgb, var(--accent) 15%, transparent); }
  .next .node { border-style: dashed; border-color: var(--muted); }
  .when { font-family: var(--font); font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .what { font-size: 1.15rem; font-weight: 500; color: var(--ink); }
  .muted-what { color: var(--text-2); font-weight: 400; }
  .who { font-size: 0.9rem; color: var(--text-2); }
  .proof { align-self: flex-start; margin-top: 6px; font-family: var(--font); font-size: 12px; color: var(--accent-ink);
           padding: 3px 8px; border: 1px solid var(--line); border-radius: 4px; text-decoration: none; background: var(--surface); }
  .proof:hover { border-color: var(--accent); }
  .proof code { font-family: inherit; margin-left: 4px; }
</style>
