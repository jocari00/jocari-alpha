---
// One card per portfolio: return since the base vs benchmark, and the equity / fixed-income split.
import { T, href, pct, fmtDate } from "../lib/i18n.js";
interface Props { lang: "en" | "es"; portfolios: any[]; results: any }
const { lang, portfolios, results } = Astro.props;
const t = T[lang];
const sign = (x: number) => (x > 0 ? "pos" : x < 0 ? "neg" : "");
const cards = portfolios.map((p) => {
  const r = results.portfolios[p.id];
  const n = r?.dates?.length ?? 0;
  if (n < 2) return { ...p, valued: false };
  const pr = r.portfolio[n - 1] / 100 - 1, br = r.benchmark[n - 1] / 100 - 1;
  return { ...p, valued: true, pr, br, x: pr - br, asof: r.dates[n - 1], estimated: r.dates[n - 1] <= results.live_start };
});
const asof = cards.find((c) => c.valued)?.asof;
---
<section class="cards" aria-label={t.nav.portfolios}>
  {cards.map((c) => (
    <a class="pcard" href={href(lang, `portfolios/${c.id}/`)}>
      <span class="eyebrow">{c.equity} % {t.equity.toLowerCase()}</span>
      <span class="pname">{c.name}</span>
      {c.valued ? (<>
        <span class="figure big">{pct(lang, c.pr)}</span>
        <span class="vs">{t.benchmark} {pct(lang, c.br)}</span>
        <span class={`delta ${sign(c.x)}`}>{pct(lang, c.x)} <span class="dl">{t.difference.toLowerCase()}</span></span>
      </>) : <span class="placeholder">{t.notValued}</span>}
      <span class="split" aria-hidden="true">
        {c.equity > 0 && <span class="eq" style={`flex:${c.equity}`}></span>}
        {c.fixedIncome > 0 && <span class="fi" style={`flex:${c.fixedIncome}`}></span>}
      </span>
    </a>
  ))}
</section>
{asof && <p class="muted cards-note">{t.sinceStart} → {fmtDate(lang, asof)}{cards.some((c) => c.estimated) ? ` · ${t.estimated}` : ""}.
  <span class="key-eq"></span>{t.equity} <span class="key-fi"></span>{t.fixedIncome}</p>}

<style>
  .cards { display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: -3rem;
           grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); position: relative; z-index: 1; }
  .pcard { display: flex; flex-direction: column; gap: 4px; padding: 22px 20px 0; background: var(--surface);
           color: var(--text); text-decoration: none; min-height: 210px; transition: background 0.15s; }
  .pcard:hover { background: var(--surface-2); }
  .pcard:hover .pname { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 4px; }
  .pcard .eyebrow { margin: 0; color: var(--muted); }
  .pname { font-family: var(--serif); font-size: 1.35rem; font-weight: 600; }
  .big { font-size: 2.1rem; line-height: 1.1; margin-top: 10px; }
  .vs { font-size: 0.85rem; color: var(--text-2); }
  .delta { font-size: 0.85rem; font-weight: 600; }
  .dl { font-weight: 400; color: var(--muted); }
  .split { display: flex; gap: 2px; height: 4px; margin: auto -20px 0; padding-top: 18px; box-sizing: content-box; }
  .split span { height: 4px; }
  .eq, .key-eq { background: var(--series-1); }
  .fi, .key-fi { background: var(--gold); opacity: 0.55; }
  .cards-note { margin-top: 12px; }
  .key-eq, .key-fi { display: inline-block; width: 14px; height: 4px; margin: 0 6px 2px 12px; vertical-align: middle; }
  @media (max-width: 560px) { .cards { margin-top: -2rem; } .pcard { min-height: 0; padding-bottom: 0; } }
</style>
