---
import { T, href } from "../lib/i18n.js";
import { loadResults } from "../lib/data.js";

interface Props {
  lang: "en" | "es"; title?: string; description?: string; path?: string;
  kicker?: string; heading?: string; lede?: string;
}
const { lang, title, description, path = "", kicker, heading, lede } = Astro.props;
const t = T[lang];
const other = lang === "en" ? "es" : "en";
const pageTitle = title ? `${title} | Jocari Alpha` : `Jocari Alpha | ${t.tagline}`;
const { pending } = loadResults();
const nav = [
  ["portfolios/", t.nav.portfolios], ["commentary/", t.nav.commentary],
  ["methodology/", t.nav.methodology], ["about/", t.nav.about],
];
const current = path.split("/")[0] + (path ? "/" : "");
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description ?? t.tagline} />
  <link rel="alternate" hreflang="en" href={href("en", path)} />
  <link rel="alternate" hreflang="es" href={href("es", path)} />
  <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@300;400;500;600&display=swap" />
  <script is:inline>
    try {
      const q = new URLSearchParams(location.search).get("theme");
      const t = q === "light" || q === "dark" ? q : localStorage.getItem("theme");
      if (t) document.documentElement.dataset.theme = t;
    } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">{lang === "en" ? "Skip to content" : "Ir al contenido"}</a>
  <header class="topbar">
    <div class="wrap bar">
      <a class="brand" href={href(lang)}>Jocari Alpha</a>
      <nav aria-label={lang === "en" ? "Main" : "Principal"}>
        <ul>
          {nav.map(([p, label]) => (
            <li><a href={href(lang, p)} aria-current={current === p ? "page" : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="tools">
        <a class="lang" href={href(other, path)} hreflang={other} lang={other} aria-label={t.switchLabel}>{t.switchTo}</a>
        <button class="theme" type="button" aria-label={t.theme} title={t.theme} data-theme-toggle>
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9A7 7 0 0 1 12 3Z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    {(heading || Astro.slots.has("head")) && (
      <div class="page-head wrap">
        {kicker && <p class="kicker">{kicker}</p>}
        {heading && <h1>{heading}</h1>}
        {lede && <p class="lede">{lede}</p>}
        <slot name="head" />
      </div>
    )}
    {pending && <div class="wrap"><p class="pending" role="note">{t.pending}</p></div>}
    <div class="wrap body"><slot /></div>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <p class="foot-brand">Jocari Alpha<br /><span>{t.tagline}</span></p>
      <div>
        <p class="legal-note">{t.footer}</p>
        <ul class="foot-links">
          <li><a href={href(lang, "legal/")}>{t.fullLegal}</a></li>
          <li><a href="https://www.linkedin.com/in/jordi-carreras-ribot/" rel="noopener">LinkedIn</a></li>
          <li>{lang === "en" ? "Charts by" : "Gráficos de"} <a href="https://www.tradingview.com/" rel="noopener">TradingView Lightweight Charts™</a></li>
        </ul>
      </div>
    </div>
  </footer>
  <script is:inline>
    document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === "dark"
        : matchMedia("(prefers-color-scheme: dark)").matches;
      root.dataset.theme = dark ? "light" : "dark";
      try { localStorage.setItem("theme", root.dataset.theme); } catch {}
      window.dispatchEvent(new Event("themechange"));
    });
  </script>
</body>
</html>

<style is:global>
  /* Tokens: white page, navy ink, one blue accent; gold only as the benchmark's data colour. */
  :root {
    color-scheme: light;
    --bg: #ffffff; --surface: #ffffff; --surface-2: #f3f5f8;
    --ink: #0e2240; --text: #0e2240; --text-2: #3d4a5e; --muted: #5a6578;
    --line: #dde2e9; --grid: #e9edf2;
    --bar: #0e2240; --on-bar: #ffffff; --on-bar-2: #b6c2d4;
    --accent: #2a5fa8; --accent-ink: #1f4f92;
    --series-1: #2a5fa8; --series-2: #b08a3e;
    --fi: #c9d3e1;
    --pos: #1c7440; --neg: #b3362b;
    --font: "Libre Franklin", "Franklin Gothic", "Helvetica Neue", Arial, sans-serif;
    --serif: var(--font); /* one grotesque family throughout; headings set light */
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #0a1424; --surface: #0f1c31; --surface-2: #142440;
      --ink: #eef2f7; --text: #eef2f7; --text-2: #c2cbd8; --muted: #9aa7ba;
      --line: #22324b; --grid: #1a2a43;
      --bar: #060d19; --on-bar: #eef2f7; --on-bar-2: #9aa7ba;
      --accent: #5b8fd6; --accent-ink: #8fb4e8;
      --series-1: #5b8fd6; --series-2: #ad8636;
      --fi: #2b3d5a;
      --pos: #5cc58a; --neg: #ec8378;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0a1424; --surface: #0f1c31; --surface-2: #142440;
    --ink: #eef2f7; --text: #eef2f7; --text-2: #c2cbd8; --muted: #9aa7ba;
    --line: #22324b; --grid: #1a2a43;
    --bar: #060d19; --on-bar: #eef2f7; --on-bar-2: #9aa7ba;
    --accent: #5b8fd6; --accent-ink: #8fb4e8;
    --series-1: #5b8fd6; --series-2: #ad8636;
    --fi: #2b3d5a;
    --pos: #5cc58a; --neg: #ec8378;
  }

  /* Type scale (1.25): 13 / 16 / 20 / 25 / 31 / 39 / 49 */
  *, *::before, *::after { box-sizing: border-box; }
  html { background: var(--bg); }
  body { margin: 0; background: var(--bg); color: var(--text); font: 400 16px/1.65 var(--font);
         font-variant-numeric: tabular-nums lining-nums; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: 100%; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 720px) { .wrap { padding: 0 40px; } }
  a { color: var(--accent-ink); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { color: var(--ink); }
  a:focus-visible, button:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  h1, h2, h3 { font-family: var(--font); color: var(--ink); }
  h1 { font-size: clamp(2.2rem, 5.5vw, 3.3rem); font-weight: 300; line-height: 1.1; letter-spacing: -0.025em; margin: 0 0 1.1rem; max-width: 22ch; }
  h2 { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 300; line-height: 1.2; letter-spacing: -0.02em; margin: 4.5rem 0 1.25rem; }
  h3 { font-size: 1.1rem; font-weight: 600; line-height: 1.35; letter-spacing: -0.005em; margin: 0 0 0.5rem; }
  p { margin: 0 0 1rem; }
  .muted { color: var(--muted); font-size: 0.875rem; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 8px; background: var(--surface); padding: 8px; z-index: 10; }

  /* Top bar */
  .topbar { background: var(--bar); color: var(--on-bar); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 36px; min-height: 60px; padding-top: 10px; padding-bottom: 10px; }
  .brand { font-size: 1.15rem; font-weight: 600; letter-spacing: -0.01em; color: var(--on-bar); text-decoration: none; margin-right: auto; }
  .brand:hover { color: var(--on-bar); }
  nav ul { display: flex; flex-wrap: wrap; gap: 4px 28px; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--on-bar-2); text-decoration: none; font-size: 0.875rem; padding: 6px 0; }
  nav a:hover, nav a[aria-current="page"] { color: var(--on-bar); }
  nav a[aria-current="page"] { box-shadow: inset 0 -2px 0 var(--accent); }
  .tools { display: flex; align-items: center; gap: 16px; }
  .lang { font-size: 0.875rem; color: var(--on-bar-2); text-decoration: none; }
  .lang:hover { color: var(--on-bar); }
  .theme { background: none; border: 1px solid color-mix(in srgb, var(--on-bar-2) 45%, transparent); color: var(--on-bar-2);
           border-radius: 6px; width: 30px; height: 30px; display: grid; place-items: center; cursor: pointer; }
  @media (max-width: 760px) { nav { order: 3; width: 100%; } nav ul { gap: 2px 22px; } }

  /* Page head */
  .page-head { padding-top: clamp(2.75rem, 7vw, 5rem); padding-bottom: 1rem; }
  .kicker { color: var(--muted); font-size: 0.95rem; margin: 0 0 0.85rem; }
  .lede { font-size: clamp(1.05rem, 2vw, 1.25rem); line-height: 1.55; color: var(--text-2); max-width: 60ch; margin: 0; }
  .pending { margin: 1.5rem 0 2rem; padding: 12px 16px; background: var(--surface-2); color: var(--text-2);
             font-size: 0.9rem; border-radius: 6px; max-width: 70ch; }
  .body { padding-bottom: 5rem; }

  .site-footer { border-top: 1px solid var(--line); padding: 40px 0 56px; font-size: 0.875rem; color: var(--text-2); }
  .footer-grid { display: grid; gap: 24px; }
  @media (min-width: 720px) { .footer-grid { grid-template-columns: 1fr 2.4fr; } }
  .foot-brand { font-size: 1.05rem; font-weight: 600; color: var(--ink); }
  .foot-brand span { font-family: var(--font); font-size: 0.875rem; color: var(--muted); }
  .legal-note { max-width: 72ch; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 6px 24px; list-style: none; padding: 0; margin: 0; color: var(--muted); }

  /* Shared */
  table { width: 100%; border-collapse: collapse; font-size: 0.94rem; }
  th, td { text-align: left; padding: 12px 10px; border-bottom: 1px solid var(--line); }
  th { color: var(--muted); font-weight: 500; font-size: 0.82rem; }
  td.num, th.num { text-align: right; }
  .table-scroll { overflow-x: auto; }
  .pos { color: var(--pos); } .neg { color: var(--neg); }
  .placeholder { color: var(--muted); }
  .prose { max-width: 68ch; font-size: 1.03rem; }
  .prose h2 { font-size: 1.5rem; margin: 2.75rem 0 0.75rem; }
  .prose li { margin-bottom: 0.45rem; }
  .prose table { margin: 1rem 0 1.5rem; }
  .tag { display: inline-block; font-size: 0.78rem; padding: 1px 8px; border-radius: 99px;
         background: var(--surface-2); color: var(--text-2); }
  .figure { font-variant-numeric: tabular-nums lining-nums; }
</style>
