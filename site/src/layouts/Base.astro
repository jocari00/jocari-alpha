---
import { T, href } from "../lib/i18n.js";
import { loadResults } from "../lib/data.js";

interface Props { lang: "en" | "es"; title?: string; description?: string; path?: string }
const { lang, title, description, path = "" } = Astro.props;
const t = T[lang];
const other = lang === "en" ? "es" : "en";
const pageTitle = title ? `${title} · Jocari Alpha` : `Jocari Alpha · ${t.tagline}`;
const { sample } = loadResults();
const nav = [
  ["", t.nav.home], ["portfolios/", t.nav.portfolios], ["commentary/", t.nav.commentary],
  ["methodology/", t.nav.methodology], ["about/", t.nav.about],
];
const current = path.split("/")[0] + (path ? "/" : "");
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description ?? t.tagline} />
  <link rel="alternate" hreflang="en" href={href("en", path)} />
  <link rel="alternate" hreflang="es" href={href("es", path)} />
  <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.svg`} type="image/svg+xml" />
  <script is:inline>
    try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href={href(lang)}>
        <span class="brand-name">Jocari Alpha</span>
        <span class="brand-tag">{t.tagline}</span>
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map(([p, label]) => (
            <li><a href={href(lang, p)} aria-current={current === p ? "page" : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="tools">
        <a class="lang" href={href(other, path)} hreflang={other} lang={other} aria-label={t.switchLabel}>{t.switchTo}</a>
        <button class="theme" type="button" aria-label={t.theme} title={t.theme} data-theme-toggle>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9A7 7 0 0 1 12 3Z"/></svg>
        </button>
      </div>
    </div>
  </header>
  {sample && <p class="sample-banner wrap" role="note">{t.sample}</p>}
  <main id="main" class="wrap">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p>{t.footer} <a href={href(lang, "legal/")}>{t.fullLegal}</a>.</p>
      <p class="muted">© {new Date().getFullYear()} Jocari Alpha ·
        Charts by <a href="https://www.tradingview.com/" rel="noopener">TradingView Lightweight Charts™</a></p>
    </div>
  </footer>
  <script is:inline>
    document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === "dark"
        : matchMedia("(prefers-color-scheme: dark)").matches;
      root.dataset.theme = dark ? "light" : "dark";
      try { localStorage.setItem("theme", root.dataset.theme); } catch {}
      window.dispatchEvent(new Event("themechange"));
    });
  </script>
</body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #fcfcfb; --surface: #ffffff; --surface-2: #f3f2ef;
    --text: #0b0b0b; --text-2: #52514e; --muted: #75736d;
    --line: #e4e2dd; --grid: #ecebe7;
    --accent: #2a78d6; --accent-ink: #1d5fb0;
    --series-1: #2a78d6; --series-2: #eb6834;
    --pos: #00731f; --neg: #c0362c;
    --radius: 10px;
    --font: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #141413; --surface: #1a1a19; --surface-2: #232321;
      --text: #ffffff; --text-2: #c3c2b7; --muted: #9a988f;
      --line: #33322f; --grid: #2a2a28;
      --accent: #3987e5; --accent-ink: #7fb2f0;
      --series-1: #3987e5; --series-2: #d95926;
      --pos: #4cc46a; --neg: #ef7a70;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #141413; --surface: #1a1a19; --surface-2: #232321;
    --text: #ffffff; --text-2: #c3c2b7; --muted: #9a988f;
    --line: #33322f; --grid: #2a2a28;
    --accent: #3987e5; --accent-ink: #7fb2f0;
    --series-1: #3987e5; --series-2: #d95926;
    --pos: #4cc46a; --neg: #ef7a70;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { background: var(--bg); }
  body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.6 var(--font);
         -webkit-text-size-adjust: 100%; }
  .wrap { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
  a { color: var(--accent-ink); text-underline-offset: 2px; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); margin: 2.5rem 0 0.75rem; }
  h2 { font-size: 1.45rem; margin: 2.75rem 0 0.75rem; }
  h3 { font-size: 1.1rem; margin: 1.5rem 0 0.5rem; }
  p { margin: 0 0 1rem; }
  .muted { color: var(--muted); font-size: 0.875rem; }
  .lede { font-size: 1.15rem; color: var(--text-2); max-width: 65ch; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 8px; background: var(--surface); padding: 8px; z-index: 10; }

  .site-header { border-bottom: 1px solid var(--line); background: var(--bg); }
  .header-row { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; padding-top: 14px; padding-bottom: 14px; }
  .brand { display: flex; flex-direction: column; text-decoration: none; color: var(--text); margin-right: auto; }
  .brand-name { font-family: var(--serif); font-size: 1.25rem; font-weight: 700; }
  .brand-tag { font-size: 0.78rem; color: var(--muted); }
  nav ul { display: flex; flex-wrap: wrap; gap: 4px 16px; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--text-2); text-decoration: none; font-size: 0.95rem; padding: 4px 0; }
  nav a:hover, nav a[aria-current="page"] { color: var(--text); box-shadow: inset 0 -2px 0 var(--accent); }
  .tools { display: flex; align-items: center; gap: 10px; }
  .lang { font-size: 0.875rem; color: var(--text-2); }
  .theme { background: none; border: 1px solid var(--line); color: var(--text-2); border-radius: 8px;
           width: 34px; height: 34px; display: grid; place-items: center; cursor: pointer; }
  @media (max-width: 720px) { nav { order: 3; width: 100%; } nav ul { gap: 4px 14px; } }

  .sample-banner { margin-top: 16px; padding: 10px 14px; border-radius: var(--radius);
                   background: var(--surface-2); color: var(--text-2); font-size: 0.9rem; border-left: 3px solid var(--accent); }
  main { padding-bottom: 3rem; }
  .site-footer { border-top: 1px solid var(--line); padding: 24px 0 32px; font-size: 0.875rem; color: var(--text-2); }

  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; }
  .grid { display: grid; gap: 16px; }
  @media (min-width: 720px) { .grid-2 { grid-template-columns: 1fr 1fr; } .grid-3 { grid-template-columns: repeat(3, 1fr); } }

  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); }
  th { color: var(--text-2); font-weight: 600; font-size: 0.85rem; }
  td.num, th.num { text-align: right; }
  .table-scroll { overflow-x: auto; }
  .pos { color: var(--pos); } .neg { color: var(--neg); }
  .placeholder { color: var(--muted); font-style: italic; }
  .prose { max-width: 70ch; }
  .prose li { margin-bottom: 0.4rem; }
  .tag { display: inline-block; font-size: 0.75rem; padding: 1px 8px; border-radius: 99px;
         background: var(--surface-2); color: var(--text-2); border: 1px solid var(--line); }
</style>
