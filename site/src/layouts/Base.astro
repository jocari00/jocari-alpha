---
import { T, href } from "../lib/i18n.js";
import { loadResults } from "../lib/data.js";
import Logo from "../components/Logo.astro";

interface Props {
  lang: "en" | "es"; title?: string; description?: string; path?: string;
  kicker?: string; heading?: string; lede?: string;
}
const { lang, title, description, path = "", kicker, heading, lede } = Astro.props;
const t = T[lang];
const other = lang === "en" ? "es" : "en";
const pageTitle = title ? `${title} | Jocari Alpha` : `Jocari Alpha | ${t.tagline}`;
const { pending } = loadResults();
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pageUrl = new URL(href(lang, path), Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
const metaDescription = description ?? t.description;
const nav = [
  ["portfolios/", t.nav.portfolios], ["commentary/", t.nav.commentary],
  ["methodology/", t.nav.methodology], ["about/", t.nav.about],
];
const current = path.split("/")[0] + (path ? "/" : "");
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <link rel="canonical" href={pageUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Jocari Alpha" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Jocari Alpha: five model portfolios, from all bonds to all equity" />
  <meta property="og:locale" content={lang === "en" ? "en_GB" : "es_ES"} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="alternate" hreflang="en" href={href("en", path)} />
  <link rel="alternate" hreflang="es" href={href("es", path)} />
  <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@300;400;500;600&display=swap" />
  <script is:inline>
    try {
      const q = new URLSearchParams(location.search).get("theme");
      const t = q === "light" || q === "dark" ? q : localStorage.getItem("theme");
      if (t) document.documentElement.dataset.theme = t;
    } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">{lang === "en" ? "Skip to content" : "Ir al contenido"}</a>
  <header class="topbar">
    <div class="wrap bar">
      <a class="brand" href={href(lang)}><Logo size={30} /><span>Jocari Alpha</span></a>
      <nav aria-label={lang === "en" ? "Main" : "Principal"}>
        <ul>
          {nav.map(([p, label]) => (
            <li><a href={href(lang, p)} aria-current={current === p ? "page" : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="tools">
        <a class="lang" href={href(other, path)} hreflang={other} lang={other} aria-label={t.switchLabel}>{t.switchTo}</a>
        <button class="theme" type="button" aria-label={t.theme} title={t.theme} data-theme-toggle>
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9A7 7 0 0 1 12 3Z"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    {(heading || Astro.slots.has("head")) && (
      <div class="page-head wrap">
        {kicker && <p class="label">{kicker}</p>}
        {heading && <h1>{heading}</h1>}
        {lede && <p class="lede">{lede}</p>}
        <slot name="head" />
      </div>
    )}
    {pending && <div class="wrap"><p class="pending" role="note">{t.pending}</p></div>}
    <div class="wrap body"><slot /></div>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="foot-brand"><Logo size={26} /><p>Jocari Alpha<br /><span>{t.tagline}</span></p></div>
      <div>
        <p class="legal-note">{t.footer}</p>
        <ul class="foot-links">
          <li><a href={href(lang, "legal/")}>{t.fullLegal}</a></li>
          <li><a href="https://www.linkedin.com/in/jordi-carreras-ribot/" rel="noopener">LinkedIn</a></li>
          <li>{lang === "en" ? "Charts by" : "Gráficos de"} <a href="https://www.tradingview.com/" rel="noopener">TradingView Lightweight Charts™</a></li>
        </ul>
      </div>
    </div>
  </footer>
  <script is:inline>
    document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === "dark"
        : matchMedia("(prefers-color-scheme: dark)").matches;
      root.dataset.theme = dark ? "light" : "dark";
      try { localStorage.setItem("theme", root.dataset.theme); } catch {}
      window.dispatchEvent(new Event("themechange"));
    });
  </script>
  <script is:inline>
    (() => {
      const nav = document.querySelector(".topbar nav");
      if (!nav) return;
      const cur = nav.querySelector('[aria-current="page"]');
      const update = () => {
        nav.classList.toggle("more-l", nav.scrollLeft > 4);
        nav.classList.toggle("more-r", nav.scrollLeft + nav.clientWidth < nav.scrollWidth - 4);
      };
      // Keep the current tab in view; redo it once the web font has loaded and widened the tabs.
      const place = () => {
        if (cur && nav.scrollWidth > nav.clientWidth) {
          const n = nav.getBoundingClientRect(), c = cur.getBoundingClientRect();
          const target = nav.scrollLeft + (c.left - n.left) - (n.width - c.width) / 2;
          nav.scrollLeft = Math.max(0, Math.min(target, nav.scrollWidth - nav.clientWidth));
        }
        update();
      };
      place();
      document.fonts?.ready.then(place);
      nav.addEventListener("scroll", update, { passive: true });
      addEventListener("resize", update);
    })();
  </script>
</body>
</html>

<style is:global>
  /* Page-to-page crossfade (cross-document view transitions; browsers without support just navigate).
     The header and footer keep their place so only the content changes. */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition { navigation: auto; }
    ::view-transition-old(root), ::view-transition-new(root) { animation-duration: 220ms; }
  }
  .topbar { view-transition-name: topbar; }
  .site-footer { view-transition-name: site-footer; }
  /* Tokens from DESIGN.md (values marked est. there are estimates from the reference screenshot). */
  :root {
    color-scheme: light;
    --bg: #f5f2eb; --surface: #fbfaf6; --surface-2: #efebe2;
    --ink: #16181d; --text: #16181d; --text-2: #5f6168; --muted: #6b6d73;
    --line: #e3ded3; --grid: #e9e5dc;
    --accent: #1f2e57; --accent-ink: #1f2e57; --on-accent: #ffffff;
    --attention: #8f5b12;
    --series-1: #2a5fa8; --series-2: #b08a3e;
    --fi: #d6dbe4;
    --pos: #1c7440; --neg: #b3362b;
    --font: "Libre Franklin", "Franklin Gothic", "Helvetica Neue", Arial, sans-serif;
    --serif: var(--font);
    --mono: var(--font); /* no monospace: labels and dates use the same family */
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #13151a; --surface: #191c22; --surface-2: #20242b;
      --ink: #f1efe9; --text: #f1efe9; --text-2: #b7b9bf; --muted: #8f9198;
      --line: #2c3038; --grid: #23272e;
      --accent: #9db3e6; --accent-ink: #b3c5ee; --on-accent: #13151a;
      --attention: #e0a54a;
      --series-1: #5b8fd6; --series-2: #ad8636;
      --fi: #39404c;
      --pos: #5cc58a; --neg: #ec8378;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #13151a; --surface: #191c22; --surface-2: #20242b;
    --ink: #f1efe9; --text: #f1efe9; --text-2: #b7b9bf; --muted: #8f9198;
    --line: #2c3038; --grid: #23272e;
    --accent: #9db3e6; --accent-ink: #b3c5ee; --on-accent: #13151a;
    --attention: #e0a54a;
    --series-1: #5b8fd6; --series-2: #ad8636;
    --fi: #39404c;
    --pos: #5cc58a; --neg: #ec8378;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { background: var(--bg); }
  body { margin: 0; background: var(--bg); color: var(--text); font: 400 15.5px/1.6 var(--font);
         font-variant-numeric: tabular-nums lining-nums; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: 100%; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 720px) { .wrap { padding: 0 40px; } }
  a { color: var(--accent-ink); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:hover { color: var(--ink); }
  a:focus-visible, button:focus-visible, summary:focus-visible, [tabindex]:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  h1, h2, h3 { font-family: var(--font); color: var(--ink); }
  h1 { font-size: clamp(2.2rem, 5.2vw, 3.4rem); font-weight: 300; line-height: 1.08; letter-spacing: -0.025em; margin: 0 0 1rem; max-width: 22ch; }
  h2 { font-size: clamp(1.45rem, 2.8vw, 1.9rem); font-weight: 300; line-height: 1.2; letter-spacing: -0.02em; margin: 4.5rem 0 1.25rem; }
  h3 { font-size: 1rem; font-weight: 500; line-height: 1.35; margin: 0 0 0.4rem; }
  p { margin: 0 0 1rem; }
  .muted { color: var(--muted); font-size: 0.875rem; }
  .mono { font-size: 0.82rem; font-variant-numeric: tabular-nums; }
  .label { font-family: var(--font); font-size: 11px; font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase;
           color: var(--muted); margin: 0 0 0.75rem; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 8px; background: var(--surface); padding: 8px; z-index: 10; }

  /* Header with tabs */
  .topbar { border-bottom: 1px solid var(--line); background: var(--bg); }
  .bar { display: flex; flex-wrap: wrap; align-items: stretch; gap: 0 40px; min-height: 64px; }
  .brand { display: flex; align-items: center; gap: 11px; font-size: 1.15rem; font-weight: 600; letter-spacing: -0.015em; color: var(--ink);
           text-decoration: none; margin-right: auto; }
  .brand:hover { color: var(--ink); }
  .topbar nav { display: flex; }
  .topbar nav ul { display: flex; flex-wrap: wrap; gap: 0 28px; list-style: none; margin: 0; padding: 0; }
  .topbar nav li { display: flex; }
  .topbar nav a { display: flex; align-items: center; color: var(--text-2); text-decoration: none; font-size: 0.875rem;
          border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .topbar nav a:hover { color: var(--ink); }
  .topbar nav a[aria-current="page"] { color: var(--ink); font-weight: 500; border-bottom-color: var(--accent); }
  .tools { display: flex; align-items: center; gap: 16px; }
  .lang { font-size: 0.85rem; color: var(--text-2); text-decoration: none; }
  .lang:hover { color: var(--ink); }
  .theme { background: var(--surface); border: 1px solid var(--line); color: var(--text-2); border-radius: 4px;
           width: 30px; height: 30px; display: grid; place-items: center; cursor: pointer; }
  @media (max-width: 760px) {
    .bar { min-height: 56px; }
    .topbar nav { order: 3; width: 100%; overflow-x: auto; scrollbar-width: none; }
    .topbar nav::-webkit-scrollbar { display: none; }
    .topbar nav ul { flex-wrap: nowrap; gap: 0 22px; }
    .topbar nav a { padding: 12px 0; white-space: nowrap; }
    /* Fade the edge where more tabs are hidden, so it reads as "swipe for more". */
    .topbar nav.more-r { -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 48px), transparent); }
    .topbar nav.more-l { -webkit-mask-image: linear-gradient(to left, #000 calc(100% - 48px), transparent); mask-image: linear-gradient(to left, #000 calc(100% - 48px), transparent); }
    .topbar nav.more-l.more-r { -webkit-mask-image: linear-gradient(to right, transparent, #000 48px, #000 calc(100% - 48px), transparent); mask-image: linear-gradient(to right, transparent, #000 48px, #000 calc(100% - 48px), transparent); }
  }

  /* Page head */
  .page-head { padding-top: clamp(2.5rem, 6vw, 4.25rem); padding-bottom: 0.5rem; }
  .lede { font-size: clamp(1.05rem, 1.8vw, 1.2rem); line-height: 1.55; color: var(--text-2); max-width: 62ch; margin: 0; }
  .pending { margin: 1.5rem 0 2rem; padding: 12px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: 4px;
             color: var(--text-2); font-size: 0.875rem; max-width: 72ch; }
  .body { padding-bottom: 5rem; }

  .site-footer { border-top: 1px solid var(--line); padding: 36px 0 52px; font-size: 0.85rem; color: var(--text-2); }
  .footer-grid { display: grid; gap: 24px; }
  @media (min-width: 720px) { .footer-grid { grid-template-columns: 1fr 2.4fr; } }
  .foot-brand { display: flex; gap: 12px; align-items: flex-start; }
  .foot-brand p { margin: 0; font-weight: 600; color: var(--ink); }
  .foot-brand span { font-weight: 400; color: var(--muted); }
  .legal-note { max-width: 72ch; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 6px 24px; list-style: none; padding: 0; margin: 0; color: var(--muted); }

  /* Shared: lists, tables, segmented control */
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rows > li { border-bottom: 1px solid var(--line); }
  table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  th, td { text-align: left; padding: 12px 10px; border-bottom: 1px solid var(--line); }
  th { font-family: var(--font); font-size: 11px; font-weight: 400; letter-spacing: 0.05em; text-transform: uppercase; color: var(--muted); }
  td.num, th.num { text-align: right; }
  .table-scroll { overflow-x: auto; }
  .pos { color: var(--pos); } .neg { color: var(--neg); }
  .placeholder { color: var(--muted); }
  .prose { max-width: 68ch; font-size: 1.02rem; }
  .prose h2 { font-size: 1.5rem; margin: 2.75rem 0 0.75rem; }
  .prose li { margin-bottom: 0.45rem; }
  .prose table { margin: 1rem 0 1.5rem; }
  .tag { display: inline-block; font-family: var(--font); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase;
         padding: 1px 6px; border: 1px solid var(--line); border-radius: 4px; color: var(--muted); }
  .figure { font-variant-numeric: tabular-nums lining-nums; }
  .btn-primary { display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px; border-radius: 4px;
                 background: var(--accent); color: var(--on-accent); font-weight: 500; font-size: 0.95rem; text-decoration: none; }
  a.btn-primary:hover, a.btn-primary:focus-visible { color: var(--on-accent); filter: brightness(1.15); }
  /* Same lift as the risk-ladder columns. */
  @media (prefers-reduced-motion: no-preference) {
    .btn-primary { transition: transform 200ms ease-out, filter 200ms ease-out; }
    a.btn-primary:hover, a.btn-primary:focus-visible { transform: scale(1.04); }
  }
  .btn-quiet { font-size: 0.95rem; color: var(--accent-ink); }
  .segmented { display: inline-flex; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; background: var(--surface); }
  .segmented button { font: 500 0.78rem var(--font); padding: 6px 12px; border: 0; border-left: 1px solid var(--line);
                      background: none; color: var(--text-2); cursor: pointer; }
  .segmented button:first-child { border-left: 0; }
  .segmented button[aria-pressed="true"] { background: var(--accent); color: var(--on-accent); }
</style>
