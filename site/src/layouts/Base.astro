---
import { T, href } from "../lib/i18n.js";
import { loadResults } from "../lib/data.js";

interface Props {
  lang: "en" | "es"; title?: string; description?: string; path?: string;
  eyebrow?: string; heading?: string; lede?: string;
}
const { lang, title, description, path = "", eyebrow, heading, lede } = Astro.props;
const t = T[lang];
const other = lang === "en" ? "es" : "en";
const pageTitle = title ? `${title} · Jocari Alpha` : `Jocari Alpha · ${t.tagline}`;
const { pending } = loadResults();
const nav = [
  ["portfolios/", t.nav.portfolios], ["commentary/", t.nav.commentary],
  ["methodology/", t.nav.methodology], ["about/", t.nav.about],
];
const current = path.split("/")[0] + (path ? "/" : "");
const hasHead = heading || Astro.slots.has("head");
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description ?? t.tagline} />
  <link rel="alternate" hreflang="en" href={href("en", path)} />
  <link rel="alternate" hreflang="es" href={href("es", path)} />
  <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" />
  <script is:inline>
    try {
      const q = new URLSearchParams(location.search).get("theme");
      const t = q === "light" || q === "dark" ? q : localStorage.getItem("theme");
      if (t) document.documentElement.dataset.theme = t;
    } catch {}
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="band">
    <header class="site-header wrap">
      <a class="brand" href={href(lang)} aria-label="Jocari Alpha — Home">
        <svg class="mark" viewBox="0 0 32 32" aria-hidden="true"><rect x="1" y="1" width="30" height="30" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 22 L14 14 L18 18 L24 9" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>
        <span class="brand-name">Jocari <em>Alpha</em></span>
      </a>
      <nav aria-label="Main">
        <ul>
          {nav.map(([p, label]) => (
            <li><a href={href(lang, p)} aria-current={current === p ? "page" : undefined}>{label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="tools">
        <a class="lang" href={href(other, path)} hreflang={other} lang={other} aria-label={t.switchLabel}>{other.toUpperCase()}</a>
        <button class="theme" type="button" aria-label={t.theme} title={t.theme} data-theme-toggle>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9A7 7 0 0 1 12 3Z"/></svg>
        </button>
      </div>
    </header>
    {hasHead && (
      <div class="page-head wrap">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {heading && <h1>{heading}</h1>}
        {lede && <p class="head-lede">{lede}</p>}
        <slot name="head" />
      </div>
    )}
    {pending && <div class="wrap"><p class="sample-banner" role="note">{t.pending}</p></div>}
  </div>
  <main id="main" class="wrap">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <p class="brand-name small">Jocari <em>Alpha</em></p>
        <p class="muted">{t.tagline}</p>
      </div>
      <div>
        <p class="legal-note">{t.footer}</p>
        <p class="muted"><a href={href(lang, "legal/")}>{t.fullLegal}</a>{" "}·{" "}
          <a href="https://www.linkedin.com/in/jordi-carreras-ribot/" rel="noopener">LinkedIn</a> ·
          Charts by <a href="https://www.tradingview.com/" rel="noopener">TradingView Lightweight Charts™</a></p>
      </div>
    </div>
  </footer>
  <script is:inline>
    document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === "dark"
        : matchMedia("(prefers-color-scheme: dark)").matches;
      root.dataset.theme = dark ? "light" : "dark";
      try { localStorage.setItem("theme", root.dataset.theme); } catch {}
      window.dispatchEvent(new Event("themechange"));
    });
  </script>
</body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f7f5f0; --surface: #ffffff; --surface-2: #efece4;
    --navy: #0b1f3a; --navy-2: #13294a; --on-navy: #ffffff; --on-navy-2: #b9c4d6;
    --text: #14181f; --text-2: #4a4f58; --muted: #6b7079;
    --line: #e2ddd2; --grid: #ece8df;
    --accent: #2a5fa8; --accent-ink: #1e4f91; --gold: #b08a3e;
    --series-1: #2a5fa8; --series-2: #b08a3e;
    --pos: #1f7a3d; --neg: #b23a2e;
    --radius: 4px;
    --font: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    --serif: "Source Serif 4", "Iowan Old Style", Georgia, serif;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --bg: #0b1220; --surface: #101a2b; --surface-2: #16223a;
      --navy: #08101d; --navy-2: #101a2b; --on-navy: #f2f1ec; --on-navy-2: #9fabbf;
      --text: #f2f1ec; --text-2: #b9bec8; --muted: #8b919c;
      --line: #24314a; --grid: #1b2840;
      --accent: #5b8fd6; --accent-ink: #8fb4e8; --gold: #c4a05a;
      --series-1: #5b8fd6; --series-2: #ad8636;
      --pos: #5cc58a; --neg: #ec8378;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #0b1220; --surface: #101a2b; --surface-2: #16223a;
    --navy: #08101d; --navy-2: #101a2b; --on-navy: #f2f1ec; --on-navy-2: #9fabbf;
    --text: #f2f1ec; --text-2: #b9bec8; --muted: #8b919c;
    --line: #24314a; --grid: #1b2840;
    --accent: #5b8fd6; --accent-ink: #8fb4e8; --gold: #c4a05a;
    --series-1: #5b8fd6; --series-2: #ad8636;
    --pos: #5cc58a; --neg: #ec8378;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { background: var(--bg); }
  body { margin: 0; background: var(--bg); color: var(--text); font: 400 16px/1.65 var(--font);
         font-feature-settings: "tnum" 1, "cv11" 1; -webkit-font-smoothing: antialiased; -webkit-text-size-adjust: 100%; }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 720px) { .wrap { padding: 0 32px; } }
  a { color: var(--accent-ink); text-decoration-thickness: 1px; text-underline-offset: 3px; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  h1, h2, h3 { font-family: var(--serif); font-weight: 600; letter-spacing: -0.015em; line-height: 1.15; }
  h2 { font-size: clamp(1.5rem, 3vw, 1.9rem); margin: 4rem 0 1.25rem; }
  h3 { font-size: 1.15rem; margin: 1.5rem 0 0.5rem; }
  p { margin: 0 0 1rem; }
  .muted { color: var(--muted); font-size: 0.875rem; }
  .eyebrow { font: 600 0.72rem/1.4 var(--font); letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); margin: 0 0 0.75rem; }
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 8px; background: var(--surface); padding: 8px; z-index: 10; }

  /* Navy band: header + page head */
  .band { background: var(--navy); color: var(--on-navy); }
  .site-header { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 32px; padding-top: 18px; padding-bottom: 18px;
                 border-bottom: 1px solid rgb(255 255 255 / 0.12); }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--on-navy); text-decoration: none; margin-right: auto; }
  .mark { width: 26px; height: 26px; color: var(--gold); }
  .brand-name { font-family: var(--serif); font-size: 1.3rem; font-weight: 600; letter-spacing: -0.01em; margin: 0; }
  .brand-name em { font-style: italic; font-weight: 400; color: var(--gold); }
  .brand-name.small { font-size: 1.1rem; color: var(--text); }
  nav ul { display: flex; flex-wrap: wrap; gap: 4px 28px; list-style: none; margin: 0; padding: 0; }
  nav a { color: var(--on-navy-2); text-decoration: none; font-size: 0.9rem; font-weight: 500; padding: 6px 0; }
  nav a:hover, nav a[aria-current="page"] { color: var(--on-navy); box-shadow: inset 0 -1px 0 var(--gold); }
  .tools { display: flex; align-items: center; gap: 14px; }
  .lang { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; color: var(--on-navy-2); text-decoration: none; }
  .lang:hover { color: var(--on-navy); }
  .theme { background: none; border: 1px solid rgb(255 255 255 / 0.25); color: var(--on-navy-2); border-radius: 2px;
           width: 30px; height: 30px; display: grid; place-items: center; cursor: pointer; }
  @media (max-width: 760px) { nav { order: 3; width: 100%; } nav ul { gap: 2px 20px; } }
  .page-head { padding-top: clamp(2.5rem, 7vw, 4.5rem); padding-bottom: clamp(2.5rem, 6vw, 4rem); }
  .page-head h1 { font-size: clamp(2.2rem, 5.5vw, 3.6rem); margin: 0 0 1rem; max-width: 20ch; color: var(--on-navy); }
  .head-lede { font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--on-navy-2); max-width: 58ch; margin: 0; }

  .sample-banner { margin: 0; padding: 0 0 4.5rem 14px; color: var(--on-navy-2);
                   font-size: 0.8rem; border-left: 2px solid var(--gold); line-height: 1.5; }
  main { padding-top: 0.5rem; padding-bottom: 5rem; }
  .site-footer { border-top: 1px solid var(--line); padding: 40px 0 48px; font-size: 0.85rem; color: var(--text-2); background: var(--surface); }
  .footer-grid { display: grid; gap: 24px; }
  @media (min-width: 720px) { .footer-grid { grid-template-columns: 1fr 2.2fr; } }
  .legal-note { max-width: 75ch; }

  /* Shared building blocks */
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 22px; }
  .grid { display: grid; gap: 16px; }
  @media (min-width: 720px) { .grid-2 { grid-template-columns: 1fr 1fr; } .grid-3 { grid-template-columns: repeat(3, 1fr); } }
  .section-rule { border: 0; border-top: 1px solid var(--line); margin: 4rem 0 0; }
  table { width: 100%; border-collapse: collapse; font-size: 0.92rem; font-variant-numeric: tabular-nums; }
  th, td { text-align: left; padding: 12px 10px; border-bottom: 1px solid var(--line); }
  th { color: var(--muted); font-weight: 600; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; }
  td.num, th.num { text-align: right; }
  .table-scroll { overflow-x: auto; }
  .pos { color: var(--pos); } .neg { color: var(--neg); }
  .placeholder { color: var(--muted); font-style: italic; }
  .prose { max-width: 68ch; font-size: 1.02rem; }
  .prose h2 { font-size: 1.45rem; margin: 2.75rem 0 0.75rem; }
  .prose li { margin-bottom: 0.45rem; }
  .prose table { margin: 1rem 0 1.5rem; }
  .tag { display: inline-block; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
         padding: 2px 7px; color: var(--gold); border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent); border-radius: 2px; }
  .figure { font-family: var(--serif); font-variant-numeric: lining-nums tabular-nums; }
</style>
